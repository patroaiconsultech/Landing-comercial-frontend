server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 12k;

    # Re-resolve Railway private DNS after backend redeploys.
    resolver [fd12::10] valid=1s ipv6=on;
    resolver_timeout 3s;
    set $patroai_backend "${BACKEND_INTERNAL_URL}";

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"frontend":"ok"}';
    }

    location = /v1/public/chat/status {
        limit_except GET { deny all; }

        proxy_pass $patroai_backend$request_uri;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 25s;
    }

    location = /v1/public/chat {
        limit_except POST { deny all; }

        proxy_pass $patroai_backend$request_uri;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 25s;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
