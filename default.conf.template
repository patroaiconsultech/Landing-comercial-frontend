server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 12k;

    # Re-resolve Railway private DNS after backend redeploys.
    resolver [fd12::10] valid=1s ipv6=on;
    resolver_timeout 3s;
    set $patroai_backend "${BACKEND_INTERNAL_URL}";

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"frontend":"ok"}';
    }

    location = /v1/public/chat/status {
        limit_except GET { deny all; }

        proxy_pass $patroai_backend$request_uri;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 25s;
    }

    location = /v1/public/chat {
        limit_except POST { deny all; }

        proxy_pass $patroai_backend$request_uri;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 25s;
    }

    # REVIEW CANDIDATE ONLY. Route-specific body cap; never enlarge 12k chat limit.
    # Handler is fail-closed until AO-01 signs off data, DB and auth gates.
    location = /v1/public/handoffs {
        limit_except POST { deny all; }
        client_max_body_size 48k;
        proxy_pass $patroai_backend$request_uri;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 25s;
    }


    # Administrative API: same-origin cookies; backend always enforces session, MFA, CSRF and role.
    location ^~ /v1/admin/ {
        proxy_pass $patroai_backend$request_uri;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 25s;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        add_header Cache-Control "no-store" always;
    }

    location = /dashboard {
        return 302 /dashboard.html;
    }
    location = /dashboard.html {
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
        try_files $uri =404;
    }
    location = /dashboard.js {
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }
    location = /dashboard.css {
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
